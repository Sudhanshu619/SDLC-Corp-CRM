<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ============================================================
         Capability layer (blueprint B13 / E6): three-tier group model
         mapping AC's group permissions onto res.groups + implied_ids.
         ============================================================ -->
    <record id="module_category_sdlc_crm" model="ir.module.category">
        <field name="name">SDLC Sales CRM</field>
        <field name="sequence">20</field>
    </record>

    <!-- Odoo 19: groups are grouped in the UI via res.groups.privilege
         (res.groups.category_id was removed in favour of privilege_id). -->
    <record id="privilege_sdlc_crm" model="res.groups.privilege">
        <field name="name">Sales CRM</field>
        <field name="category_id" ref="module_category_sdlc_crm"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_sdlc_crm_user" model="res.groups">
        <field name="name">Deal Owner (own deals)</field>
        <field name="privilege_id" ref="privilege_sdlc_crm"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_sdlc_crm_all" model="res.groups">
        <field name="name">See All Deals</field>
        <field name="privilege_id" ref="privilege_sdlc_crm"/>
        <field name="implied_ids" eval="[(4, ref('group_sdlc_crm_user')), (4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>

    <record id="group_sdlc_crm_manager" model="res.groups">
        <field name="name">Sales Manager</field>
        <field name="privilege_id" ref="privilege_sdlc_crm"/>
        <field name="implied_ids" eval="[(4, ref('group_sdlc_crm_all')), (4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <!-- Grant the SDLC CRM groups to every existing/future Sales user & manager,
         so nobody hits an access error on the new models (stage history,
         journey events, scores, ...) embedded on the standard deal form.
         (4, ...) links without removing the groups' other implications. -->
    <record id="sales_team.group_sale_salesman" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_sdlc_crm_user'))]"/>
    </record>
    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_sdlc_crm_manager'))]"/>
    </record>

    <!-- Super admin: any Odoo Administrator (Settings/Administration) gets full
         SDLC Sales CRM manager rights automatically. This is the module-level
         "give the super admin full access" switch. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_sdlc_crm_manager'))]"/>
    </record>

    <!-- ============================================================
         Ownership layer: AC's "deal owners only see their own deals".
         Applied to the base user group; overridden by the all-deals group.
         ============================================================ -->
    <record id="rule_lead_own_only" model="ir.rule">
        <field name="name">SDLC Deals: own deals only</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_sdlc_crm_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_lead_all" model="ir.rule">
        <field name="name">SDLC Deals: all deals</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sdlc_crm_all'))]"/>
    </record>

    <!-- ============================================================
         Cascade (blueprint E6): deal notes/activities inherit deal
         visibility, else the chatter leaks restricted deals (F2 #7).
         ============================================================ -->
    <record id="rule_activity_own_deal" model="ir.rule">
        <field name="name">SDLC: activities on own deals only</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="domain_force">['|', '|',
            ('res_model', '!=', 'crm.lead'),
            ('user_id', '=', user.id),
            ('res_id', 'in', user.env['crm.lead'].sudo().search([('user_id','=',user.id)]).ids)]</field>
        <field name="groups" eval="[(4, ref('group_sdlc_crm_user'))]"/>
    </record>

    <!-- Journey events / logs follow the deal owner. -->
    <record id="rule_journey_event_own" model="ir.rule">
        <field name="name">SDLC: journey events on own deals</field>
        <field name="model_id" ref="model_crm_journey_event"/>
        <field name="domain_force">['|', ('lead_id', '=', False), ('lead_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_sdlc_crm_user'))]"/>
    </record>
    <record id="rule_journey_event_all" model="ir.rule">
        <field name="name">SDLC: journey events all</field>
        <field name="model_id" ref="model_crm_journey_event"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sdlc_crm_all'))]"/>
    </record>

</odoo>
