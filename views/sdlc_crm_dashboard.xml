<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Dashboard building blocks: dedicated crm.lead graph/pivot/list
         views, each pinned to its own action so they don't override the
         model's default views. These are embedded into the board below.
         ================================================================ -->

    <!-- 1) Pipeline value by stage (bar) -->
    <record id="dash_lead_graph_stage" model="ir.ui.view">
        <field name="name">sdlc.dash.lead.graph.stage</field>
        <field name="model">crm.lead</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <graph string="Pipeline Value by Stage" type="bar" sample="1">
                <field name="stage_id"/>
                <field name="expected_revenue_company" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_dash_pipeline_stage" model="ir.actions.act_window">
        <field name="name">Pipeline Value by Stage</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="dash_lead_graph_stage"/>
        <field name="domain">[('type', '=', 'opportunity'), ('ac_deal_status', '=', 'open')]</field>
        <field name="context">{'search_default_stage_id': 1}</field>
    </record>

    <!-- 2) Deals by owner x status (pivot) -->
    <record id="dash_lead_pivot_owner" model="ir.ui.view">
        <field name="name">sdlc.dash.lead.pivot.owner</field>
        <field name="model">crm.lead</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <pivot string="Deals by Owner" sample="1">
                <field name="user_id" type="row"/>
                <field name="ac_deal_status" type="col"/>
                <field name="expected_revenue_company" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_dash_deals_owner" model="ir.actions.act_window">
        <field name="name">Deals by Owner</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="dash_lead_pivot_owner"/>
        <field name="domain">[('type', '=', 'opportunity')]</field>
    </record>

    <!-- 3) Biggest open deals (list). Ranked by expected revenue, with the
         native star priority and probability as the urgency signals. -->
    <record id="dash_lead_list_score" model="ir.ui.view">
        <field name="name">sdlc.dash.lead.list.top</field>
        <field name="model">crm.lead</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Biggest Open Deals" default_order="expected_revenue desc" create="false">
                <field name="priority" widget="priority" nolabel="1"/>
                <field name="name"/>
                <field name="stage_id"/>
                <field name="expected_revenue" sum="Pipeline"/>
                <field name="probability" widget="percentage" optional="show"/>
                <field name="activity_state" widget="activity_state" optional="show"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>
    <record id="action_dash_top_deals" model="ir.actions.act_window">
        <field name="name">Biggest Open Deals</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="dash_lead_list_score"/>
        <field name="domain">[('type', '=', 'opportunity'), ('ac_deal_status', '=', 'open')]</field>
    </record>

    <!-- ================================================================
         Lost Deals: a first-class view of closed-lost opportunities.
         Marking a deal Lost archives the lead (active=False), so this action
         disables active_test to surface them, and the list exposes the lost
         reason and who owned it for post-mortem review.
         ================================================================ -->
    <record id="view_lost_deals_list" model="ir.ui.view">
        <field name="name">sdlc.lost.deals.list</field>
        <field name="model">crm.lead</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Lost Deals" create="false" default_order="write_date desc"
                  decoration-muted="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="account_id" optional="show"/>
                <field name="stage_id"/>
                <field name="lost_reason_id"/>
                <field name="expected_revenue" sum="Lost Value"/>
                <field name="user_id"/>
                <field name="write_date" string="Lost On" optional="show"/>
            </list>
        </field>
    </record>
    <record id="action_lost_deals" model="ir.actions.act_window">
        <field name="name">Lost Deals</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_lost_deals_list"/>
        <field name="domain">[('type', '=', 'opportunity'), ('ac_deal_status', '=', 'lost')]</field>
        <field name="context">{'active_test': False, 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No lost deals yet</p>
            <p>Deals marked Lost show up here with their lost reason for review.</p>
        </field>
    </record>

    <record id="action_sdlc_crm_dashboard_kpi" model="ir.actions.client">
        <field name="name">CRM Dashboard</field>
        <field name="tag">sdlc_crm_dashboard</field>
    </record>

</odoo>
