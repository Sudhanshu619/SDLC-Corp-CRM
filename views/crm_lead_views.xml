<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Deal form: multi-contact, per-deal currency, deal status, the
         prospect block (details with no contact record) and smart buttons to
         stage history / journey events. -->
    <record id="crm_lead_view_form_sdlc" model="ir.ui.view">
        <field name="name">crm.lead.form.sdlc</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- Deal status pill between Won and Lost: green while open,
                 red once lost. Display only: disabled, no action. -->
            <xpath expr="//header/button[@name='action_set_won_rainbowman']" position="after">
                <button string="Open" class="btn-success pe-none" disabled="1"
                        invisible="ac_deal_status != 'open'"/>
                <button string="Lost" class="btn-danger pe-none" disabled="1"
                        invisible="ac_deal_status != 'lost'"/>
                <button string="Won" class="btn-success pe-none" disabled="1"
                        invisible="ac_deal_status != 'won'"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" icon="fa-history"
                        name="action_view_stage_history"
                        invisible="journey_event_count == 0 and contact_count == 0">
                    <field name="journey_event_count" widget="statinfo" string="Events"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='expected_revenue']" position="after">
                <field name="deal_currency_id" groups="base.group_multi_currency"/>
                <field name="expected_revenue_company" groups="base.group_multi_currency"/>
            </xpath>

            <xpath expr="(//field[@name='partner_id'])[last()]" position="after">
                <field name="account_id" options="{'no_create': True}"/>
                <!-- What this deal belongs to: a region, an event, a quarter.
                     Native field, normally buried under the marketing tab. -->
                <!-- What this deal belongs to. One pipeline per line of
                     business, each with its own stages - see "My Pipelines". -->
                <field name="team_id" string="Pipeline"
                       options="{'no_create_edit': True}"/>
                <field name="ac_deal_status" readonly="1"/>
                <field name="lc_status_change_date"/>
                <!-- Forecast groups on this date and weights by probability;
                     a deal without it falls into the "None" bucket and is
                     invisible to every forecast. -->
                <field name="date_deadline" string="Expected closing"/>
            </xpath>

            <!-- Prospect block. A card in the pipeline can carry the person's
                 name, company and job title with NO res.partner behind it;
                 email and phone are already on the native form. The button is
                 the only path from prospect to contact, and it is manual. -->
            <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position="before">
                <field name="contact_name" string="Prospect"
                       placeholder="e.g. Dana Fisher" invisible="partner_id"/>
                <field name="partner_name" string="Company"
                       placeholder="e.g. ACME Industries" invisible="partner_id"/>
                <field name="function" string="Job Position" invisible="partner_id"/>
                <button name="action_create_contact" type="object"
                        string="Create a contact from these details"
                        class="btn-link ps-0" icon="fa-user-plus"
                        invisible="partner_id or (not contact_name and not partner_name and not email_from)"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Deal Contacts" name="deal_contacts">
                    <field name="contact_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="function"/>
                        </list>
                    </field>
                    <field name="contact_count" invisible="1"/>
                </page>
                <page string="Stage History" name="stage_history">
                    <field name="stage_history_ids" readonly="1">
                        <list>
                            <field name="stage_id"/>
                            <field name="previous_stage_id"/>
                            <field name="date_entered"/>
                            <field name="date_left"/>
                            <field name="duration_hours" widget="float_time"/>
                            <field name="user_id"/>
                        </list>
                    </field>
                </page>
                <page string="Journey Events" name="journey_events">
                    <field name="journey_event_ids" readonly="1">
                        <list>
                            <field name="create_date"/>
                            <field name="event"/>
                            <field name="value_from"/>
                            <field name="value_to"/>
                            <field name="note"/>
                            <field name="user_id"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
