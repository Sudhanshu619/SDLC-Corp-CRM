<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_tracked_event_view_list" model="ir.ui.view">
        <field name="name">crm.tracked.event.list</field>
        <field name="model">crm.tracked.event</field>
        <field name="arch" type="xml">
            <list default_order="event_date desc">
                <field name="event_date"/>
                <field name="name"/>
                <field name="event_type"/>
                <field name="partner_id"/>
                <field name="email"/>
                <field name="url"/>
            </list>
        </field>
    </record>

    <record id="crm_tracked_event_view_form" model="ir.ui.view">
        <field name="name">crm.tracked.event.form</field>
        <field name="model">crm.tracked.event</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="event_type"/>
                            <field name="event_date"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="email"/>
                            <field name="url"/>
                        </group>
                    </group>
                    <field name="event_data"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="crm_tracked_event_view_search" model="ir.ui.view">
        <field name="name">crm.tracked.event.search</field>
        <field name="model">crm.tracked.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="email"/>
                <group>
                    <filter name="g_type" string="Type" context="{'group_by': 'event_type'}"/>
                    <filter name="g_partner" string="Contact" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_crm_tracked_event" model="ir.actions.act_window">
        <field name="name">Behavioural Events</field>
        <field name="res_model">crm.tracked.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
