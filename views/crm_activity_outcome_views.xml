<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_activity_outcome_view_list" model="ir.ui.view">
        <field name="name">crm.activity.outcome.list</field>
        <field name="model">crm.activity.outcome</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="sentiment" widget="badge"
                       decoration-success="sentiment == 'positive'"
                       decoration-danger="sentiment == 'negative'"/>
                <field name="activity_type_ids" widget="many2many_tags"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="crm_activity_outcome_view_form" model="ir.ui.view">
        <field name="name">crm.activity.outcome.form</field>
        <field name="model">crm.activity.outcome</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sentiment"/>
                        <field name="activity_type_ids" widget="many2many_tags"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_activity_outcome" model="ir.actions.act_window">
        <field name="name">Task Outcomes</field>
        <field name="res_model">crm.activity.outcome</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
