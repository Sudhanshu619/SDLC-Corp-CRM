<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Contacts carry an explicit External / Internal split, so the people a
         deal brought in never get confused with the people working the deals. -->
    <record id="res_partner_view_form_sdlc" model="ir.ui.view">
        <field name="name">res.partner.form.sdlc</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0" role="status"
                     invisible="contact_scope != 'external' or has_system_access">
                    <i class="fa fa-lock me-2"/>
                    External contact - no access to this system. Granting portal
                    access is the only thing that would let them sign in.
                </div>
            </xpath>

            <xpath expr="//field[@name='function']" position="after">
                <field name="contact_scope" widget="radio" options="{'horizontal': true}"/>
                <field name="has_system_access" invisible="1"/>
            </xpath>

        </field>
    </record>

    <record id="res_partner_view_search_sdlc" model="ir.ui.view">
        <field name="name">res.partner.search.sdlc</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='type_company']" position="before">
                <filter name="scope_external" string="External (prospects &amp; clients)"
                        domain="[('contact_scope', '=', 'external')]"/>
                <filter name="scope_internal" string="Internal (our team)"
                        domain="[('contact_scope', '=', 'internal')]"/>
                <filter name="has_access" string="Can sign in"
                        domain="[('user_ids', '!=', False)]"/>
                <separator/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="group_contact_scope" string="Contact Type"
                        context="{'group_by': 'contact_scope'}"/>
            </xpath>
        </field>
    </record>

    <record id="res_partner_view_list_sdlc" model="ir.ui.view">
        <field name="name">res.partner.list.sdlc</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="contact_scope" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Accounts: the companies deals belong to (crm.lead.account_id).
         Same res.partner records as Contacts, filtered to companies, so a deal's
         Account and this list can never drift apart. Account-specific custom
         fields go on this list and the company form as they are specified. -->
    <record id="res_partner_view_list_account" model="ir.ui.view">
        <field name="name">res.partner.list.account</field>
        <field name="model">res.partner</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Accounts" sample="1">
                <field name="name" string="Account"/>
                <field name="website" widget="url" optional="show"/>
                <field name="phone" optional="show"/>
                <field name="email" optional="show"/>
                <field name="city" optional="show"/>
                <field name="country_id" optional="show"/>
                <field name="user_id" string="Owner" widget="many2one_avatar_user" optional="show"/>
                <field name="opportunity_count" string="Deals" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_sdlc_accounts" model="ir.actions.act_window">
        <field name="name">Accounts</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_company', '=', True)]</field>
        <field name="context">{'default_is_company': True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('res_partner_view_list_account')}),
            (0, 0, {'view_mode': 'kanban'}),
            (0, 0, {'view_mode': 'form'})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add an account</p>
            <p>The companies your deals are with. A deal's Account is picked
               from this list.</p>
        </field>
    </record>

</odoo>
