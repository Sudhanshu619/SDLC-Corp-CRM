<?xml version="1.0" encoding="utf-8"?>
<!--
    One campaign out of the box.

    Deals are grouped by campaign, and `crm.lead._default_campaign_id` assigns
    the campaign automatically when exactly one exists. A fresh database had
    none, so every new deal was created with no campaign at all.

    noupdate="1": rename it, or delete it once you have your own campaigns -
    an upgrade will not put it back.
-->
<odoo noupdate="1">

    <record id="utm_campaign_general" model="utm.campaign">
        <field name="name">General</field>
    </record>

</odoo>
