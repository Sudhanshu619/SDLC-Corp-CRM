<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Customer tag used by the Won fan-out flow. Contacts are tagged with a
         res.partner.category (contacts use category_id, not crm.tag). -->
    <record id="tag_customer" model="res.partner.category">
        <field name="name">Customer</field>
        <field name="color">10</field>
    </record>

    <!-- ============================================================
         FLOW 1 - Self-propelling stage->task loop (blueprint B5).
         When a deal enters a stage, create the stage-appropriate task for
         the deal owner. Combined with each task type's native
         triggered_next_type_id chaining, this is AC's four-beat loop.
         ============================================================ -->
    <record id="automation_stage_task" model="base.automation">
        <field name="name">Deal enters stage -> create stage task</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="trigger">on_stage_set</field>
        <field name="filter_domain">[('type', '=', 'opportunity')]</field>
    </record>
    <record id="action_stage_task" model="ir.actions.server">
        <field name="name">Create stage task for owner</field>
        <field name="base_automation_id" ref="automation_stage_task"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">records._create_stage_activity()</field>
    </record>

    <!-- ============================================================
         FLOW 2 - Marketing/sales handoff (blueprint B3).
         When a contact's score crosses the threshold and it has not yet been
         handed off, create a deal and mark it handed off (idempotent).
         ============================================================ -->
    <record id="automation_score_handoff" model="base.automation">
        <field name="name">Contact score >= 75 -> create deal (handoff)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="trigger">on_create_or_write</field>
        <field name="filter_domain">[('contact_score', '>=', 75), ('crm_handoff_done', '=', False), ('is_company', '=', False)]</field>
    </record>
    <record id="action_score_handoff" model="ir.actions.server">
        <field name="name">Create deal from contact score</field>
        <field name="base_automation_id" ref="automation_score_handoff"/>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">
for partner in records:
    # Mark handed off FIRST so any partner writes triggered by deal creation
    # (opportunity counts, etc.) no longer match the filter -> no duplicate deals.
    partner.write({'crm_handoff_done': True})
    env['crm.lead']._create_deal_from_contact(partner)
        </field>
    </record>

    <!-- ============================================================
         FLOW 3 - Won fan-out (blueprint B8/B9).
         When a deal is Won, tag every contact on the deal as Customer and
         post an audit note. A one-to-many fan-out from a deal fact to
         person-level state.
         ============================================================ -->
    <record id="automation_won_fanout" model="base.automation">
        <field name="name">Deal Won -> tag contacts as Customer</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="trigger">on_create_or_write</field>
        <field name="filter_pre_domain">[('ac_deal_status', '!=', 'won')]</field>
        <field name="filter_domain">[('ac_deal_status', '=', 'won')]</field>
    </record>
    <record id="action_won_fanout" model="ir.actions.server">
        <field name="name">Tag deal contacts as Customer</field>
        <field name="base_automation_id" ref="automation_won_fanout"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">
tag = env.ref('sdlc_CRM.tag_customer', raise_if_not_found=False)
for lead in records:
    contacts = lead.contact_ids or lead.partner_id
    if tag and contacts:
        contacts.write({'category_id': [(4, tag.id)]})
    lead.message_post(body="Deal won: %s contact(s) tagged as Customer." % len(contacts))
        </field>
    </record>

</odoo>
